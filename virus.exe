local player = game.Players.LocalPlayer
local userId = player.UserId

local authorizedUserIds = {}
local success, result = pcall(function()
    return loadstring(game:HttpGet("https://raw.githubusercontent.com/Zeus-newui/Junkie-Development/heads/main/settings.lua"))()
end)

if success and type(result) == "table" then
    authorizedUserIds = result
else
    print("Failed to load authorized user IDs.")
end

local isAuthorized = false
for _, id in ipairs(authorizedUserIds) do
    if userId == id then
        isAuthorized = true
        break
    end
end

if isAuthorized then
    -- Optional: Notify VIP users
    game.StarterGui:SetCore("SendNotification", {
        Title = "Welcome VIP",
        Text = "Welcome VIP user! Enjoy your perks.",
        Duration = 5
    })
    -- Load VIP script
    loadstring(game:HttpGet("https://raw.githubusercontent.com/Zeus-newui/Junkie-Development/refs/heads/main/keysystem/main.lua"))()
else
    -- Load non-VIP script
    loadstring(game:HttpGet("https://api.junkie-development.de/api/v1/luascripts/public/74a3e244d227624a252d5335c0c58c73012798e76922309592e0287c4a28d303/download"))()
end
